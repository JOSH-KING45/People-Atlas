# Set as a secret in hosted environment. Used to encrypt optional user API keys.
SETTINGS_ENCRYPTION_KEY=
# Optional included AI for all visitors; server only, fixed OpenRouter free route.
SHARED_OPENROUTER_API_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for a secret.
SUPABASE_SECRET_KEY=

# Canonical origin for OAuth redirects. Use http://localhost:3000 for local development.
APP_URL=https://your-app.vercel.app
# Enable after configuring Google OAuth credentials in Supabase Auth.
GOOGLE_AUTH_ENABLED=false
